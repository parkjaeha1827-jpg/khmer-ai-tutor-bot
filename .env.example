# Telegram Bot Configuration
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Whitelist Telegram User ID for Private Access
# Send /start to @userinfobot or @raw_data_bot on Telegram to find your numeric ID
# Multiple IDs can be separated by commas (e.g. 123456789,987654321)
ALLOWED_USER_ID=your_numeric_telegram_user_id

# Google Gemini API Key
# Get from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Edge TTS Voices
# Khmer: km-KH-PisethNeural (Male), km-KH-SreymomNeural (Female)
# English: en-US-AriaNeural (Female), en-US-GuyNeural (Male)
KHMER_VOICE=km-KH-PisethNeural
ENGLISH_VOICE=en-US-AriaNeural
